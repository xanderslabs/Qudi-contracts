# Copy to .env at the repository root, where Foundry loads it from. That file is gitignored.
# No private key ever goes here: the scripts sign only through Foundry's `--account <keystore>`
# or `--ledger`. Optional variables are commented out rather than left blank, because an empty
# value fails parsing where an absent one falls back cleanly.

# ---- RPC ----
# Arc testnet (chain id 5042002).
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Arc mainnet (chain id 5042). Confirm from Arc's own documentation before use.
ARC_RPC_URL=

# ---- script/Deploy.s.sol ----
# The chain's USDC. Arc testnet's is below. Arc mainnet: confirm from Circle's and Arc's own
# documentation before use; members must be warned about unofficial stablecoin variants, so a
# wrong address here is a member safety problem, not a typo. Local anvil: a
# test/mocks/MockUSDC.sol deployed first with forge create.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# The single key behind both timelocks. Never the deployer.
OWNER=
# Sets the pause flags with no delay. On a public chain it must differ from OWNER and OPERATOR.
PAUSER=
# Every ManualStrategy's operator, and CreditCore's operator and allocation role. On a public
# chain it must differ from OWNER and PAUSER.
OPERATOR=
# ComplianceRegistry's screener, the key that blocks an address.
SCREENER=
# The protocol treasury in Config. Receives only.
TREASURY=
# The configuration timelock's delay in seconds. Arc mainnet refuses less than 86400 (24 hours).
TIMELOCK_DELAY=86400
# The delay in seconds of the timelock that guards the paths to member money. Arc mainnet refuses
# less than 604800 (7 days).
TIMELOCK_DELAY_LONG=604800
# The hash of the Credit Agreement a member's first draw must carry.
CREDIT_AGREEMENT_HASH=
# The commit being deployed, recorded in the deployment record and not checked.
# GIT_COMMIT=
# The smoke community is permanent and has the deployer as its host. Arc testnet runs it
# (false, and the deployer holds 150 USDC for its three deposits). Arc mainnet must set true: the
# deploy refuses to run it there.
SKIP_SMOKE=false

# ---- script/CheckDeployment.s.sol ----
# Reads USDC_ADDRESS, TIMELOCK_DELAY, TIMELOCK_DELAY_LONG and CREDIT_AGREEMENT_HASH above.
# Optional: the record to check, if not deployments/<chainId>.json.
# DEPLOYMENT_RECORD=

# ---- script/build-calibur.sh ----
# Optional: another checkout of Calibur 249cac5e with its libraries, if not lib/calibur.
# CALIBUR_ROOT=
