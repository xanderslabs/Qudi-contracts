# Foundry deploy environment for script/Deploy.s.sol.
# Copy to .env at the repository root. That file is gitignored. Never commit real values.
#
# Foundry loads .env from the directory holding foundry.toml, which is the repository root.
#
# The deployer is msg.sender, so the key comes from the forge flag, not from here:
#   forge script script/Deploy.s.sol --rpc-url arc_testnet --account <keystore> --broadcast

# RPC for each target chain. foundry.toml reads these as the arc_testnet and arc endpoints.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_RPC_URL=

# The ERC-20 USDC on the target chain. Required on every chain, local included:
# Deploy.s.sol never deploys a token.
#   Arc testnet USDC: 0x3600000000000000000000000000000000000000
#   Arc mainnet: confirm the address against Circle's own documentation before any
#     deploy that matters. Members must be warned about unofficial stablecoin variants,
#     so a wrong address here is a member-facing safety problem, not a config typo.
#   Local anvil: deploy test/mocks/MockUSDC.sol with forge create first
#     and paste its address, so test-only code stays out of the deploy path.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional. Each defaults to the deployer when unset.
# Leave these commented out rather than blank: Deploy.s.sol reads them with
# vm.envOr, and an empty string fails address parsing where an absent variable
# falls back cleanly.
#
# TREASURY=          protocol treasury
# CONFIG_OWNER=      config and vault ownership at the end of the deploy.
#                    Testnet: a single EOA. Mainnet: the TimelockController.
# VENUE_OWNER=       venue and adapter ownership. Defaults to CONFIG_OWNER.
#                    Keep it separate on mainnet: venue owner functions are the
#                    every-epoch manual procedure, not economic parameters, and
#                    must not sit behind the timelock.
# SKIP_SMOKE_COMMUNITY=  set true to skip the post-deploy smoke community
